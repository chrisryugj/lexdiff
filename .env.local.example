# LexDiff 환경 변수 예시 — 이 파일을 .env.local 로 복사해 값을 채우세요.
#   cp .env.local.example .env.local
# 실제 키는 절대 커밋하지 마세요 (.env.local 은 gitignore 대상).

# ── 필수 ────────────────────────────────────────────────
# Google AI Studio — Gemini 3 Flash (폴백/BYOK 엔진)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 법제처 Open API 키 (무료)
# 발급: https://open.law.go.kr/LSO/openApi/guideResult.do
LAW_OC=

# ── Supabase (로그인·일일 쿼터) ──────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 로그 식별자 해싱용 솔트
SUPABASE_LOG_SALT=

# 브라우저에 노출되는 값 (위 URL/ANON_KEY 와 동일하게)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 선택 ────────────────────────────────────────────────
# S1 라우터 전용 분리 키 (Gemini 3.1 Flash-Lite). 미설정 시 GEMINI_API_KEY 사용
GEMINI_ROUTER_API_KEY=

# 테미스 릴레이 (Primary 엔진). 미설정 시 Gemini 단일 엔진으로 동작
RELAY_URL=
RELAY_TOKEN=

# 캐시 / rate-limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 배포 메타
NEXT_PUBLIC_BASE_URL=
